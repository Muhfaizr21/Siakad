#### [NEW] [useThemeStore.js](file:///d:/siakad/frontend/src/store/useThemeStore.js)

Zustand store baru (tanpa persist, selalu fetch fresh dari API):

```js
import { create } from 'zustand';

const useThemeStore = create((set, get) => ({
  theme: null,          // Object tema dari API
  isLoaded: false,      // Apakah sudah selesai fetch
  error: null,

  // Fetch tema global dari API publik
  fetchTheme: async () => {
    try {
      const res = await fetch('/api/public/theme');
      const data = await res.json();
      if (data.status === 'success') {
        set({ theme: data.data, isLoaded: true });
        get().applyTheme(data.data);
      }
    } catch (err) {
      set({ error: err.message, isLoaded: true });
    }
  },

  // Inject CSS custom properties ke document root
  applyTheme: (t) => {
    const root = document.documentElement.style;
    root.setProperty('--theme-primary', t.color_primary);
    root.setProperty('--theme-secondary', t.color_secondary);
    root.setProperty('--theme-accent', t.color_accent);
    root.setProperty('--theme-bg', t.color_background);
    root.setProperty('--theme-surface', t.color_surface);
    root.setProperty('--theme-text', t.color_text_primary);
    root.setProperty('--theme-text-muted', t.color_text_muted);
    root.setProperty('--theme-h1', t.color_h1);
    root.setProperty('--theme-h2', t.color_h2);
    root.setProperty('--theme-h3', t.color_h3);
    root.setProperty('--theme-sidebar-bg', t.sidebar_bg_color);
    root.setProperty('--theme-sidebar-text', t.sidebar_text_color);
    root.setProperty('--theme-btn-radius', t.button_radius);
    // Font families
    root.setProperty('--theme-font-headline', `'${t.font_headline}', sans-serif`);
    root.setProperty('--theme-font-body', `'${t.font_body}', sans-serif`);
    // Inject Google Fonts dynamically
    injectGoogleFont(t.font_headline);
    injectGoogleFont(t.font_body);
  },

  // Preview tema sementara (untuk live preview di admin editor)
  previewTheme: (overrides) => {
    const merged = { ...get().theme, ...overrides };
    get().applyTheme(merged);
  },

  // Kembalikan ke tema yang tersimpan (batal preview)
  revertPreview: () => {
    if (get().theme) get().applyTheme(get().theme);
  }
}));
```

